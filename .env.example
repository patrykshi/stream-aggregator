# Configuração opcional, mantenha os valores verdadeiros apenas em .env (não versionado).
PORT=7001
# Sem Docker, não exponha o painel administrativo na rede.
BIND_HOST=127.0.0.1
TMDB_API_KEY=
TRAKT_CLIENT_ID=
MDBLIST_API_KEY=
# Se vazio, o estúdio de capas utiliza o compositor local em vez do Gemini.
GEMINI_API_KEY=

# Adaptador do criador de capas Python já instalado no PC.
# Pasta que contém render.py e assets/; o bind mount é somente leitura.
PYTHON_COVER_PATH=/home/patryk-rocha/Projetos/Midia/TMDB/tmdb-capas
# GEMINI_API_KEY pode ser salva pela UI em Configurações -> Integrações.
# Sem chave, o botão de geração IA não chama nem simula um gerador de imagens.
